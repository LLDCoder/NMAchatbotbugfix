      "scope": "personal",
      "caveats": [
        {
          "value": "عرض «قيد الإنجاز» هو تبويب المهام المطلوبة في صفحة مهام طلباتي، وليس حالة طلب مخزَّنة؛ عضوية الصف تُحدَّد بعملية المهام المطلوبة.",
          "evidence": [
            {
              "sourceId": "k_0e1395e3dabfa9ebb60d:p4"
            }
          ]
        },
        {
          "value": "هذه قائمة شخصية للمستخدم الموثَّق؛ دور المدير لا يحوّلها إلى قائمة فريق، والقائمة الشخصية لا تُثبت طلبات فريق آخر.",
          "evidence": [
            {
              "sourceId": "k_20ced6e0b4b58b26fc02:p7"
            }
          ]
        }
      ],
      "population": {
        "value": "كامل قائمة الانتظار المعلقة (قيد الإنجاز) من عملية المهام المطلوبة، بما فيها التعديل المعلق والموافقة الخارجية، وليست فقط قيد المراجعة",
        "evidence": [
          {
            "sourceId": "k_20ced6e0b4b58b26fc02:p9"
          }
        ]
      },
      "filterScope": {
        "value": "لا يوجد مرشّح إضافي أدخله المستخدم؛ النطاق الشخصي مفروض من العملية نفسها",
        "evidence": [
