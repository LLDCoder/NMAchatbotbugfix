            }
          ],
          "followupQuery": "",
          "requirementId": "object",
          "requiredPoints": [
            "The current role is the assigned business role shown on the signed-in staff profile in Personal Center, read from the authenticated session.",
            "Multiple assigned roles are retained; a role name or title alone does not by itself prove page, action or record permissions."
          ],
          "missingEvidenceType": "none"
        },
        {
          "reason": "Grain is the single authenticated staff profile: one signed-in user profile whose multiple department/role entries are properties of that same user, not extra users. Assigned roles are read as the complete child array of that one profile.",
