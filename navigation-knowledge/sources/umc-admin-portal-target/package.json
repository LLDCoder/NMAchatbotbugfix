    "build:nma:staging": "cross-env DISABLE_ESLINT_PLUGIN=true vite build --mode nma-staging",
    "build:nma:production": "cross-env DISABLE_ESLINT_PLUGIN=true vite build --mode nma-production",
    "build:daypop": "cross-env DISABLE_ESLINT_PLUGIN=true vite build --mode daypopproduction",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
