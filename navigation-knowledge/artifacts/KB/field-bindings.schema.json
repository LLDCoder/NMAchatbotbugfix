{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Page field semantics bindings",
  "description": "Schema for field_semantics.payload.bindings. Page facts only: no question patterns, analysis steps or answer values. Execution authorization remains gateway-owned.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "kind",
      "concept",
      "operationRef",
      "sourcePath",
      "fields"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "enum": [
          "object",
          "grain",
          "scope",
          "population",
          "group",
          "filter",
          "time",
          "attribute",
          "measure"
        ]
      },
      "concept": {
        "type": "string",
        "minLength": 1
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "operationRef": {
        "type": "string",
        "description": "Exact observed read operation identifier; does not grant permission."
      },
      "sourcePath": {
        "type": "string",
        "pattern": "^/",
        "description": "Exact observed row-array or verified entity-object JSON Pointer relative to the response root."
      },
      "fields": {
        "type": "array",
        "maxItems": 20,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "meaning": {
        "type": "string"
      },
      "contextParameters": {
        "type": "object",
        "description": "For scope/population definitions, exact expected values of all data-affecting request parameters. Matched against runtime hashes; omitted/uncovered parameters remain unverified."
      },
      "operator": {
        "enum": [
          "count",
          "sum"
        ]
      },
      "valueField": {
        "type": "string"
      },
      "conditions": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "required": [
            "field",
            "value"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "predicate": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte"
              ]
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "values": {
        "type": "array",
        "maxItems": 200,
        "uniqueItems": true,
        "items": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "sourceTimezone": {
        "type": "string"
      },
      "dateOnlyBoundary": {
        "enum": [
          "start_of_day",
          "end_of_day"
        ]
      },
      "formDefinition": {
        "type": "object",
        "required": [
          "format",
          "recordPath",
          "versionPath",
          "materialComponents"
        ],
        "properties": {
          "format": {
            "const": "schema_values/1"
          },
          "recordPath": {
            "type": "string"
          },
          "versionPath": {
            "type": ["string", "null"],
            "description": "Verified form version pointer, or null when the deployed page does not establish one. A service identifier is not a form version."
          },
          "documentPath": {
            "type": "string"
          },
          "containerPath": {
            "type": "string"
          },
          "schemaPath": {
            "type": "string"
          },
          "valuesPath": {
            "type": "string"
          },
          "componentKey": {
            "type": "string"
          },
          "requiredWhenKey": {
            "type": "string"
          },
          "materialComponents": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string"
            }
          },
          "applicabilityComplete": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
