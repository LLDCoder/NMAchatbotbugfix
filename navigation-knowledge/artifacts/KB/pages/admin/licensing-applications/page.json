      "payload": {
        "pageIdentity": {
          "id": "admin.licensing.applications",
          "portal": "admin",
          "module": "Licensing",
          "route": "/licensing/applications",
          "component": "Applications",
          "displayName": "My Application Tasks",
          "purpose": "Personal licensing application workflow work, including To Do and Completed views. This page is not a team queue or issued-license inventory."
        },
        "entryConditions": {
          "session": "authenticated Admin Portal principal",
          "permissionPath": "/licensing/applications",
          "scope": "Current user in the Licensing department as enforced by the endpoint and current authorization. Role title alone does not change the page to team scope.",
          "runtimeGrant": "must_be_checked"
        },
        "views": [
          {
            "id": "todo",
            "label": "To Do",
            "tabKey": "1",
            "default": true,
            "scope": "personal",
            "operationRef": "admin.licensing.applications.read.todo",
            "rowProjectionKey": [
              "id",
              "dispositionCaseId"
            ],
            "sourceDefinition": "Exclude completed and superseded instances, then choose the first ordered row per projection key."
          },
          {
            "id": "completed",
            "label": "Completed",
            "tabKey": "2",
            "default": false,
            "scope": "personal",
            "operationRef": "admin.licensing.applications.read.completed",
            "rowProjectionKey": [
              "id"
            ],
            "sourceDefinition": "Select completed current-instance rows and the first ordered row per application identity."
          }
        ],
        "readinessAssertions": [
          "The route and selected tab match the observed page.",
          "The required list response succeeded at both transport and business-envelope level.",
          "Loading has finished with data or an explicit successful empty state.",
          "Filters, sorting and pagination state are known.",
          "Default UI zeros during failed loading are not evidence of an empty queue."
        ],
        "regions": [
          {
            "name": "Summary cards",
            "data": "statusCount",
            "meaning": "Pre-filter projection counts across todo/completed populations."
          },
          {
            "name": "Task list",
            "data": "page.items",
            "meaning": "Current selected-tab page after filters."
          },
          {
            "name": "Pagination total",
            "data": "page.total",
            "meaning": "Filtered selected-tab collection size."
          }
        ],
        "filters": [
          {
            "control": "Search",
            "parameter": "keyword",
            "meaning": "Case-insensitive substring over application number, service names and Apply For names in inspected source."
          },
          {
            "control": "Type",
            "parameter": "serviceTypeId",
            "meaning": "Service type equality; string 1 is the frontend all-types sentinel, not a Licensing department ID."
          },
          {
            "control": "Status",
            "parameter": "processInstanceStatus",
            "meaning": "Exact equality against the row status field; options are returned in processInstanceStatus."
          },
          {
            "control": "Date range",
            "parameters": [
              "startTime",
              "endTime"
            ],
            "uiLabel": "Submission Time",
            "actualTimeField": "lastUpdatedTime",
            "meaning": "Start inclusive from start date; end exclusive at next date in inspected backend. Backend timezone is not established."
          },
          {
            "control": "My Decision",
            "parameter": "approvalStatus",
            "view": "completed",
            "meaning": "Multi-select decisions from myDecisionOptions; matched against MyDecision by inspected completed-view backend."
          }
        ],
        "pagination": {
          "parameters": [
            "pageIndex",
            "pageSize"
          ],
          "response": [
            "page.pageIndex",
            "page.pageSize",
            "page.total",
            "page.items"
          ],
          "defaultPageIndex": 1,
          "defaultPageSize": 10,
          "defaultSortField": "LastUpdatedTime",
          "defaultSortDirection": "descending",
          "tabSwitch": "Resets list, page index and filter form.",
          "runtimeLimits": "Actual accepted sizes and stable-snapshot support remain unverified."
        },
        "navigation": [
          {
            "from": "task row",
            "target": "/licensing/applications/applicationsDetails",
            "parameters": [
              "taskId",
              "activeTab"
            ],
            "entityParameter": "taskId"
          }
        ],
        "operationsSummary": {
          "readOnly": [
            "Select tab",
            "Search/filter/reset",
            "Sort",
            "Paginate",
            "Open authorized detail"
          ],
          "export": "Requires separate Export permission and uses export filter compatibility rules. It is not automatically identical to list collection under all deployments.",
          "businessWrites": [
            "Approve",
            "Reject",
            "Request Modification",
            "Send Back",
            "External Approval",
            "Recall"
          ],
          "writeBoundary": "Visible business actions are page descriptions, not read permissions or execution authorization."
        },
        "knownAmbiguities": [
          "Submission Time label differs from the inspected time field and date-filter implementation.",
          "taskStatus meaning changes in the personal Completed compatibility response.",
          "Source snapshot does not attest target deployment version."
        ]
      }
    },
