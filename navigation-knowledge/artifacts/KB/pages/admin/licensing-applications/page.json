      "payload": {
        "sourceBinding": {
          "pageRef": "/licensing/applications",
          "responseRoot": "/data",
          "views": [
            "todo",
            "completed"
          ]
        },
        "fields": [
          {
            "id": "application_id",
            "path": "/page/items/*/id",
            "type": "integer",
            "entity": "application",
            "meaning": "Application identity used by the inspected projection implementation."
          },
          {
            "id": "application_number",
            "path": "/page/items/*/applicationNumber",
            "uiLabel": "Application No.",
            "type": "string",
            "entity": "application",
            "meaning": "Business-facing application reference. Display reference and internal identity are distinct fields."
          },
          {
            "id": "task_id",
            "path": "/page/items/*/taskId",
            "type": "string",
            "entity": "workflow_task",
            "meaning": "Workflow task identity and task detail navigation parameter; not an application identity."
          },
          {
            "id": "disposition_case_id",
            "path": "/page/items/*/dispositionCaseId",
            "type": "integer_or_null",
            "entity": "disposition_case",
            "meaning": "Additional component of the personal To Do projection key."
          },
          {
            "id": "process_instance_id",
            "path": "/page/items/*/processInstanceId",
            "type": "string",
            "entity": "workflow_instance",
            "meaning": "Workflow instance represented by the row."
          },
          {
            "id": "canonical_process_instance_id",
            "path": "/page/items/*/oldProcessInstanceId",
            "type": "string_or_null",
            "entity": "workflow_instance",
            "meaning": "Legacy DTO name for the current canonical ApplicationsExt.ProcessInstanceId, per inspected projection source."
          },
          {
            "id": "application_status",
            "path": "/page/items/*/status",
            "uiLabel": "Status",
            "type": "string",
            "entity": "application_process",
            "meaning": "Application/process status displayed in the Status column. Value set comes from the response, not a fixed knowledge enumeration.",
            "filterParameter": "processInstanceStatus"
          },
          {
            "id": "task_status",
            "path": "/page/items/*/taskStatus",
            "type": "string",
            "meaning": "In To Do, the workflow task/node state. In the personal Completed response, projected to My Decision for legacy clients; interpretation is view-dependent."
          },
          {
            "id": "my_decision",
            "path": "/page/items/*/myDecision",
            "type": "string_or_null",
            "meaning": "Completed-view review decision. The current frontend renders its compatibility projection from taskStatus under My Decision; missing value renders as a dash."
          },
          {
            "id": "service_name",
            "path": "/page/items/*/serviceNameEn",
            "uiLabel": "Service Name",
            "type": "string",
            "meaning": "Service display name used by the inspected list; language mapping may be applied server-side."
          },
          {
            "id": "service_category",
            "path": "/page/items/*/serviceCategoryNameEn",
            "uiLabel": "Service Category",
            "type": "string",
            "meaning": "Service category display label."
          },
          {
            "id": "service_type",
            "path": "/page/items/*/serviceTypeNameEn",
            "uiLabel": "Type",
            "type": "string",
            "meaning": "Application service type label; serviceTypeId is its identifier."
          },
          {
            "id": "sla_display",
            "path": "/page/items/*/slaDescription",
            "uiLabel": "SLA",
            "type": "string",
            "meaning": "Formatted SLA label. Completed renders On Time/Exceeded based on the numeric SLA sign. Detailed duration/clock rules require separate verification."
          },
          {
            "id": "last_updated",
            "path": "/page/items/*/lastUpdatedTime",
            "uiLabel": "Submission Time",
            "type": "datetime",
            "meaning": "Despite the current frontend label, this column binds to lastUpdatedTime. The source describes the latest timeline update with fallback timestamps."
          },
          {
            "id": "submission_time",
            "path": "/page/items/*/submissionTime",
            "type": "datetime",
            "meaning": "Separate response timestamp; not the field bound to the currently labelled Submission Time column."
          },
          {
            "id": "page_total",
            "path": "/page/total",
            "type": "integer",
            "unit": "selected_view_projection_rows",
            "population": "after_list_filters_before_pagination",
            "meaning": "Total matching rows in the selected view; not current page length."
          },
          {
            "id": "todoCount",
            "path": "/statusCount/todoCount",
            "uiLabel": "To Do",
            "type": "integer",
            "unit": "projection_rows",
            "population": "personal_todo_projection",
            "filterScope": "before_list_filters",
            "metricRole": "total",
            "meaning": "Count of the projected personal todo collection.",
            "missingIsZero": false
          },
          {
            "id": "pendingReviewCount",
            "path": "/statusCount/pendingReviewCount",
            "uiLabel": "Pending Review",
            "type": "integer",
            "unit": "projection_rows",
            "population": "personal_todo_projection",
            "filterScope": "before_list_filters",
            "metricRole": "category",
            "meaning": "Rows whose StatusId is neither PendingModification nor ExternalApproval in inspected source. This broad set may include disposition-related states.",
            "missingIsZero": false
          },
          {
            "id": "pendingModificationCount",
            "path": "/statusCount/pendingModificationCount",
            "uiLabel": "Pending Modification",
            "type": "integer",
            "unit": "projection_rows",
            "population": "personal_todo_projection",
            "filterScope": "before_list_filters",
            "metricRole": "category",
            "meaning": "Rows with PendingModification StatusId.",
            "missingIsZero": false
          },
          {
            "id": "externalApproveCount",
            "path": "/statusCount/externalApproveCount",
            "uiLabel": "External Approval",
            "type": "integer",
            "unit": "projection_rows",
            "population": "personal_todo_projection",
            "filterScope": "before_list_filters",
            "metricRole": "category",
            "meaning": "Rows with ExternalApproval StatusId.",
            "missingIsZero": false
          },
          {
            "id": "pendingDispositionCount",
            "path": "/statusCount/pendingDispositionCount",
            "uiLabel": "Pending Disposition",
            "type": "integer",
            "unit": "projection_rows",
            "population": "personal_todo_projection",
            "filterScope": "before_list_filters",
            "metricRole": "category",
            "meaning": "Rows with PendingDisposition StatusId.",
            "missingIsZero": false
          },
          {
            "id": "dispositionVerificationCount",
            "path": "/statusCount/dispositionVerificationCount",
            "uiLabel": "Disposition Verification",
            "type": "integer",
            "unit": "projection_rows",
            "population": "personal_todo_projection",
            "filterScope": "before_list_filters",
            "metricRole": "category",
            "meaning": "Rows with DispositionVerification StatusId.",
            "missingIsZero": false
          },
          {
            "id": "completedCount",
            "path": "/statusCount/completedCount",
            "uiLabel": "Completed",
            "type": "integer",
            "unit": "projection_rows",
            "population": "personal_completed_projection",
            "filterScope": "before_list_filters",
            "metricRole": "total",
            "meaning": "Count of the projected completed collection, a different lifecycle population from todo.",
            "missingIsZero": false
          }
        ],
        "relationships": [
          {
            "id": "personal_projection_identity",
            "meaning": "Personal To Do projection identity is the pair (id, dispositionCaseId); the application identity is id. Distinct application count and projection row count are different measures."
          },
          {
            "id": "projection_order",
            "meaning": "Source orders by application id, then descending task creation and approval timestamps before projection selection."
          },
          {
            "id": "process_currentness",
            "meaning": "If canonical instance is absent, legacy visibility is preserved; otherwise only equal processInstanceId and oldProcessInstanceId survives."
          },
          {
            "id": "state_dimensions",
            "meaning": "Application/process status, workflow task status, completed review decision and summary-card category are different dimensions."
          },
          {
            "id": "summary_overlap",
            "meaning": "Pending Review excludes only modification and external approval in inspected formula. It may overlap disposition card categories; the full card set is not established as a partition."
          },
          {
            "id": "filter_scope",
            "meaning": "Status cards are created before list filters; page.total follows selected-view filters. Counts can differ under filtering."
          }
        ],
        "constraints": [
          "Definitions are source-backed drafts until target-version binding is verified.",
          "Status and decision option values are supplied by current responses; no frozen state list is assumed.",
          "Null/missing fields and failed responses have no numeric-zero meaning.",
          "No general equality between task/projection identity and application identity is implied.",
          "No fixed calendar period is implied by summary cards."
        ]
      }
    },
