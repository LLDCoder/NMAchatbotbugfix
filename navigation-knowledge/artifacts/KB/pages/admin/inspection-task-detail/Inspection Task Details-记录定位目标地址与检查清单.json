        "sourceBinding": {
          "operationRef": "GET /api/admin/inspection/tasks/{id}/checklist-template",
          "sourcePath": "/data/items"
        },
        "bindings": [
          {
            "id": "checklist",
            "kind": "attribute",
            "concept": "checklist",
            "fields": [
              "checklistName",
              "violationDescription",
              "isActive",
              "isVisibleInChecklist"
            ],
            "operationRef": "GET /api/admin/inspection/tasks/{id}/checklist-template",
            "sourcePath": "/data/items",
            "aliases": [
              "inspection checklist",
              "قائمة التحقق"
            ],
            "meaning": "Task-authorized checklist catalog. Read every active and visible item in display order. It describes items available for inspection, not checked or passed results. Checklist answer values are item names and violation descriptions. Activity and visibility are selection dependencies, not display columns. Internal id, item code and ordering metadata are not required answer properties merely to show the checklist. Preserve all selected items and their display order.",
            "conditions": [
              {
                "field": "isActive",
                "predicate": "eq",
                "value": true
              },
              {
                "field": "isVisibleInChecklist",
                "predicate": "eq",
                "value": true
              }
            ]
          }
        ],
        "relationships": [
          "Response taskId must match the verified task id. The source reports templateType=AllChecklistItems and returns the full catalog; do not invent a Book-only filter from contentType. The inspected page keeps items where isActive and isVisibleInChecklist are not false, then sorts by displayOrder.",
          "Reading this template does not start a visit or save checklist results."
        ],
        "relatedReads": [
          {
            "operationKey": "GET /api/admin/inspection/tasks/{id}/checklist-template",
            "parentOperationKey": "GET /api/admin/inspection/tasks/{id}",
            "parentPath": "/data",
            "parentField": "id",
            "parameter": "id",
            "responseKeyPath": "/data/taskId",
            "requiredFor": [
              "checklist",
              "inspection checklist",
              "قائمة التحقق",
              "required documents",
              "documents",
              "required preparation steps",
              "preparation steps",
              "prepare",
              "المستندات المطلوبة",
              "الوثائق",
              "خطوات التحضير",
              "التحضير"
            ]
          }
        ],
        "fields": {
          "id": "Internal checklist item key.",
          "checklistCode": "Catalog reference code, optional display when explicitly requested.",
          "displayOrder": "Ascending catalog display order; used to sort, not a mandatory output column.",
          "checklistName": "Checklist item name.",
          "violationDescription": "Violation criterion description for the item.",
          "isActive": "Server boolean indicating the active catalog entry.",
          "isVisibleInChecklist": "Server boolean indicating checklist visibility."
        },
        "constraints": [
          "Preparation/document requests trigger this related checklist read as supporting evidence. The checklist describes current inspection criteria, not a complete required-document inventory or an instruction to assume every criterion applies. Keep the actual task method/template and missing document requirements distinct."
        ]
      }
