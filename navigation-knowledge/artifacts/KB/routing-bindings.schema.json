{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generic page routing payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "records": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operationRef",
          "sourcePath",
          "identityField",
          "keyFields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operationRef": {
            "type": "string",
            "pattern": "^(GET|POST) /"
          },
          "sourcePath": {
            "type": "string",
            "pattern": "^/"
          },
          "identityField": {
            "type": "string",
            "minLength": 1
          },
          "keyFields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "unique": {
            "type": "boolean"
          }
        }
      }
    },
    "parameters": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "from"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operationRef": {
            "type": "string",
            "pattern": "^(GET|POST) /"
          },
          "sourcePath": {
            "type": "string",
            "pattern": "^/"
          },
          "identityField": {
            "type": "string",
            "minLength": 1
          },
          "keyFields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "unique": {
            "type": "boolean"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "enum": [
              "recordIdentity",
              "previous_record",
              "current_page"
            ]
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "from": {
                  "enum": [
                    "previous_record",
                    "current_page"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "operationRef",
                "sourcePath",
                "identityField",
                "keyFields",
                "field"
              ]
            }
          }
        ]
      }
    },
    "views": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
